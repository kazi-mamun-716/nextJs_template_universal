# Environment Configuration
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ─── Application ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Universal Next.js Boilerplate"
NEXT_PUBLIC_APP_DESCRIPTION="A production-ready, feature-isolated Next.js boilerplate."

# ─── Database (MongoDB) ───
MONGODB_URI=mongodb://localhost:27017/universal_boilerplate

# ─── Authentication (Auth.js) ───
AUTH_SECRET=your-auth-secret-at-least-32-chars-long
AUTH_URL=http://localhost:3000

# Auth Providers
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ─── Cloudinary ───
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (Resend) ───
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# ─── Encryption ───
ENCRYPTION_KEY=your-encryption-key-at-least-32-chars-long

# ─── Redis (Optional - for rate limiting) ───
# REDIS_URL=redis://localhost:6379
